# ============================================================
# CFN Kurties — Environment Variables
# Copy to .env.local for development, .env.production for prod
# ============================================================

# --- Site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3005
NEXT_PUBLIC_CONTACT_EMAIL=hello@cfnkurties.com
NEXT_PUBLIC_CONTACT_PHONE=+91 98765 43210
NEXT_PUBLIC_WHATSAPP_NUMBER=919876543210
NEXT_PUBLIC_INSTAGRAM_URL=https://instagram.com/cfnkurties
NEXT_PUBLIC_FACEBOOK_URL=https://facebook.com/cfnkurties
NEXT_PUBLIC_PINTEREST_URL=https://pinterest.com/cfnkurties

# --- Hero media (optional video) ---
NEXT_PUBLIC_HERO_VIDEO_ENABLED=false
NEXT_PUBLIC_HERO_VIDEO_SRC=/videos/hero.mp4

# --- WooCommerce (Headless) ---
# Leave empty / set USE_PLACEHOLDERS=true to use sample catalog
WOOCOMMERCE_URL=https://your-wordpress-site.com
WOOCOMMERCE_CONSUMER_KEY=ck_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
WOOCOMMERCE_CONSUMER_SECRET=cs_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
WOOCOMMERCE_USE_PLACEHOLDERS=true
NEXT_PUBLIC_WOOCOMMERCE_URL=https://your-wordpress-site.com

# --- Razorpay ---
# Leave keys empty to use mock checkout in development
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxx
RAZORPAY_MOCK=true

# --- Optional newsletter webhook (Klaviyo, Mailchimp, etc.) ---
# NEWSLETTER_WEBHOOK_URL=https://hooks.example.com/subscribe

# --- Node ---
NODE_ENV=development
