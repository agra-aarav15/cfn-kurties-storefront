# ============================================================
# CFN Kurties — Production Environment Configuration
# Target: cfnkurties.in on Oracle ARM (24GB RAM) + Cloudflare
# ============================================================

# --- Site Info ---
NEXT_PUBLIC_SITE_URL=https://cfnkurties.in
NEXT_PUBLIC_CONTACT_EMAIL=support@cfnkurties.in
NEXT_PUBLIC_CONTACT_PHONE=+91 98765 43210
NEXT_PUBLIC_WHATSAPP_NUMBER=919876543210
NEXT_PUBLIC_INSTAGRAM_URL=https://instagram.com/cfnkurties

# --- WooCommerce Backend (WordPress at cfnkurties.in/wp-admin) ---
WOOCOMMERCE_URL=https://cfnkurties.in
WOOCOMMERCE_CONSUMER_KEY=ck_your_generated_consumer_key_here
WOOCOMMERCE_CONSUMER_SECRET=cs_your_generated_consumer_secret_here
WOOCOMMERCE_USE_PLACEHOLDERS=false
NEXT_PUBLIC_WOOCOMMERCE_URL=https://cfnkurties.in

# --- Razorpay Live Production Keys ---
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_live_XXXXXXXXXXXXXX
RAZORPAY_KEY_ID=rzp_live_XXXXXXXXXXXXXX
RAZORPAY_KEY_SECRET=YourLiveKeySecretHere
RAZORPAY_MOCK=false

# --- Node Environment ---
NODE_ENV=production
